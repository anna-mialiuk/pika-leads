# Токен бота від @BotFather (окремий бот для сайту — щоб працювали кнопки статусу)
TELEGRAM_BOT_TOKEN=
# ID чату/групи, куди падають заявки (кілька — через кому)
TELEGRAM_CHAT_ID=
# Порт (Nginx проксює /api/leads і /api/admin сюди)
PORT=3010
# Журнал заявок (рядок на заявку). Поруч із ним зберігаються дані адмінки:
# leads.json (CRM), users.json (співробітники), secret.key (ключ сесій)
LEADS_FILE=/home/deploy/leads-server/leads.jsonl
# Кнопки статусу лида (long polling). 0 — вимкнути (якщо бот уже обслуговує інша система)
TELEGRAM_POLLING=1

# ---------- адмінка app.pika-leads.com ----------
# 2FA обов'язкова для всіх (1). 0 — за бажанням співробітника
ADMIN_REQUIRE_2FA=1
# Сесія без «Запомнить меня» — годин; з ним — днів
SESSION_HOURS=12
REMEMBER_DAYS=30
# Інша папка для даних (за замовчуванням — поруч із LEADS_FILE)
# DATA_DIR=/home/deploy/leads-data
# Ключ підпису сесій. Якщо не задано — генерується автоматично в secret.key
# SESSION_SECRET=

# ---------- публікація контенту сайту (кейси, блог, відгуки) ----------
# Fine-grained токен GitHub лише для репозиторію сайту:
#   Contents — Read and write, Actions — Read-only
GITHUB_TOKEN=
GITHUB_REPO=anna-mialiuk/pika-leads
GITHUB_BRANCH=main
# Адреса сайту (посилання «Открыть на сайте»)
# SITE_URL=https://pika-leads.com

# ---------- пошта: відновлення пароля (SMTP, TLS-порт 465) ----------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=ваша@gmail.com, SMTP_PASS=пароль застосунку (myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Від кого лист (за замовчуванням SMTP_USER) і підпис
# MAIL_FROM=
MAIL_FROM_NAME=Pikaleads

# ---------- реклама й аналітика з сервера (tracking.mjs, адмінка → Интеграции) ----------
# Meta Conversions API: ID пікселя і токен (Events Manager → Налаштування → Conversions API)
META_PIXEL_ID=
META_CAPI_TOKEN=
# GA4 Measurement Protocol: ID потоку і секрет (GA4 → Адміністратор → Потоки даних → Секретні ключі API)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
